# Copy to .env and adjust. The docker-compose.yml defaults match this URL.
DATABASE_URL=postgresql+psycopg://uncskate:uncskate@localhost:5432/uncskate

# Comma-separated list of allowed CORS origins (GET-only API).
# localhost for dev; the GitHub Pages origin is a placeholder until the domain lands.
# IN PRODUCTION: strip the http://localhost entries and list ONLY the live https
# origin(s) — e.g. https://uncskate.club and/or https://<user>.github.io. Leaving
# localhost in prod lets any local dev server read the API cross-origin.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:5500,https://uncskate.club
